{
  "id": "mcp-exam-coach",
  "name": "mcp-exam-coach",
  "description": "A revision persona that turns notes and PDFs into a focused study sprint, generates quizzes, tracks weak topics and exports a 24-hour cram pack you can share with your class.",
  "persona_id": "exam-coach",
  "persona_name": "Exam Coach",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9108",
  "default_port": 9108,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "exam.build_revision_sprint",
    "exam.generate_quiz",
    "exam.flashcards",
    "exam.cram_pack",
    "exam.weak_spots"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/08-mcp-exam-coach",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/08-mcp-exam-coach/src/index.js",
    "port": 9108
  }
}
