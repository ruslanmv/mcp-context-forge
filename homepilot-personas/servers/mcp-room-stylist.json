{
  "id": "mcp-room-stylist",
  "name": "mcp-room-stylist",
  "description": "An interior-design persona that turns a room photo or text description into multiple realistic redesign directions, mood boards and an affordable shopping shortlist.",
  "persona_id": "room-stylist",
  "persona_name": "Room Stylist",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9106",
  "default_port": 9106,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "stylist.analyze_room",
    "stylist.redesign_options",
    "stylist.mood_board",
    "stylist.shopping_list",
    "stylist.before_after_card"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/06-mcp-room-stylist",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/06-mcp-room-stylist/src/index.js",
    "port": 9106
  }
}
