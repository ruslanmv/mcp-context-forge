{
  "id": "mcp-general-doctor",
  "name": "mcp-general-doctor",
  "description": "A health-navigator persona that helps you organise symptoms, understand what to track, prepare questions for your clinician and recognise red flags. It does not diagnose, treat or prescribe.",
  "persona_id": "general-doctor",
  "persona_name": "General Doctor",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9110",
  "default_port": 9110,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "doctor.symptom_intake",
    "doctor.red_flag_check",
    "doctor.visit_prep_summary",
    "doctor.medication_questions",
    "doctor.followup_plan"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/10-mcp-general-doctor",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/10-mcp-general-doctor/src/index.js",
    "port": 9110
  }
}
