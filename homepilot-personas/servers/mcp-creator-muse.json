{
  "id": "mcp-creator-muse",
  "name": "mcp-creator-muse",
  "description": "A creative co-pilot for solo creators, educators and indie brands. Turns a rough idea into a social-ready script, scene list, image prompts and a viral hook in seconds.",
  "persona_id": "creator-muse",
  "persona_name": "Creator Muse",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9101",
  "default_port": 9101,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "creator.brainstorm_hooks",
    "creator.script_reel",
    "creator.storyboard_carousel",
    "creator.generate_image_prompts",
    "creator.captions_pack"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/01-mcp-creator-muse",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/01-mcp-creator-muse/src/index.js",
    "port": 9101
  }
}
