{
  "id": "mcp-personal-trainer",
  "name": "mcp-personal-trainer",
  "description": "A coaching persona that builds personalised home programmes, tracks weekly streaks, sends accountability nudges and exports a challenge card you can share with friends.",
  "persona_id": "personal-trainer",
  "persona_name": "Personal Trainer",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9105",
  "default_port": 9105,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "trainer.generate_workout",
    "trainer.weekly_plan",
    "trainer.adapt_for_pain",
    "trainer.challenge_card",
    "trainer.streak_recap"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/05-mcp-personal-trainer",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/05-mcp-personal-trainer/src/index.js",
    "port": 9105
  }
}
