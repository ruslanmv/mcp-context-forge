{
  "id": "mcp-style-muse",
  "name": "mcp-style-muse",
  "description": "A wardrobe and avatar stylist that turns a selfie or character description into multiple cohesive style directions and a shareable makeover carousel.",
  "persona_id": "style-muse",
  "persona_name": "Style Muse",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9102",
  "default_port": 9102,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "style.analyze_palette",
    "style.suggest_outfits",
    "style.makeover_plan",
    "style.capsule_wardrobe",
    "style.before_after_carousel"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/02-mcp-style-muse",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/02-mcp-style-muse/src/index.js",
    "port": 9102
  }
}
