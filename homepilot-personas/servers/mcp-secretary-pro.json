{
  "id": "mcp-secretary-pro",
  "name": "mcp-secretary-pro",
  "description": "A proactive chief-of-staff persona that plans your week, drafts messages, sets reminders, and reaches you on phone, WhatsApp or Telegram with ACK / SNOOZE / ESCALATE flows.",
  "persona_id": "secretary-pro",
  "persona_name": "Secretary Pro",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9103",
  "default_port": 9103,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "secretary.plan_week",
    "secretary.schedule_reminder",
    "secretary.draft_message",
    "secretary.escalation_ladder",
    "secretary.summarize_inbox"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/03-mcp-secretary-pro",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/03-mcp-secretary-pro/src/index.js",
    "port": 9103
  }
}
