{
  "id": "mcp-mindfulness-coach",
  "name": "mcp-mindfulness-coach",
  "description": "A self-help wellness persona that runs short grounding exercises, evening check-ins and routine builders. It is not therapy and routes to local crisis lines for any safety concern.",
  "persona_id": "mindfulness-coach",
  "persona_name": "Mindfulness Coach",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9109",
  "default_port": 9109,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "mindfulness.grounding_session",
    "mindfulness.breathwork",
    "mindfulness.evening_checkin",
    "mindfulness.calm_card",
    "mindfulness.routine_builder"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/09-mcp-mindfulness-coach",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/09-mcp-mindfulness-coach/src/index.js",
    "port": 9109
  }
}
