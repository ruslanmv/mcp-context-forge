{
  "id": "mcp-researcher",
  "name": "mcp-researcher",
  "description": "A senior research analyst persona that searches arXiv, ingests papers, summarises abstracts, compares findings and assembles cite-backed briefs you can paste into a memo or thread.",
  "persona_id": "researcher",
  "persona_name": "Researcher",
  "protocol": "MCP",
  "transport": "HTTP",
  "url": "http://localhost:9104",
  "default_port": 9104,
  "endpoints": {
    "health": "/health",
    "tools": "/tools",
    "invoke": "/mcp/call"
  },
  "tools": [
    "researcher.search_arxiv",
    "researcher.read_paper",
    "researcher.summarize_paper",
    "researcher.compare_papers",
    "researcher.build_literature_brief"
  ],
  "repo": "https://github.com/HomePilotAI/personas",
  "path": "mcp-servers/04-mcp-researcher",
  "docker": {
    "image": "homepilot/personas:latest",
    "command": "node mcp-servers/04-mcp-researcher/src/index.js",
    "port": 9104
  }
}
